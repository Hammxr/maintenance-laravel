{
	# No public ACME issuer can sign for a bare IP address, so this deployment uses
	# Caddy's internal CA (see `tls internal` below). Browsers will show a full-page
	# certificate warning until the client trusts Caddy's root — extract it with:
	#   docker compose cp caddy:/data/caddy/pki/authorities/local/root.crt .
	# Swap `tls internal` for Caddy's default once a real hostname exists: point
	# CADDY_SITE_ADDRESS at the domain, drop the `tls internal` line, and Caddy will
	# obtain a Let's Encrypt certificate on its own.
	email {$CADDY_EMAIL:admin@example.com}
	admin off

	# A client connecting to a bare IP cannot send SNI, so Caddy matches no TLS
	# connection policy and kills the handshake with "tlsv1 alert internal error"
	# — the server looks up but nothing can complete a TLS connection. This names
	# the certificate to present when SNI is absent. Note it is a global option:
	# `default_sni` is not accepted as a subdirective of `tls`. Harmless to leave
	# in place after moving to a real hostname, since browsers send SNI for those.
	default_sni {$CADDY_SITE_ADDRESS:localhost}
}

{$CADDY_SITE_ADDRESS::443} {
	tls internal

	encode zstd gzip

	# NOTE: the app container still publishes :8000 to the host, so this proxy is not
	# yet the only route in — which means `trustProxies(at: '*')` in bootstrap/app.php
	# is still trusting headers from clients that bypass Caddy entirely. Stop
	# publishing :8000 once HTTPS is confirmed working, and that comment becomes true.
	# X-Forwarded-Proto is what tells Laravel to generate https:// URLs, without which
	# Livewire and Filament asset loading break under TLS.
	reverse_proxy app:8000 {
		header_up X-Forwarded-Proto {scheme}
		header_up X-Forwarded-Host {host}
	}
}
